# ==============================================================================
# Portfolio V2 - Environment Variables
# Add these in Vercel Dashboard -> Project Settings -> Environment Variables
# ==============================================================================

# GitHub Personal Access Token (Classic or Fine-grained) for real-time heatmap sync
# Permissions needed: read:user (or public read). No repo write access required.
GITHUB_TOKEN=ghp_your_github_token_here

# Resend API Key for contact form emails
RESEND_API_KEY=re_your_resend_api_key_here
RECIPIENT_EMAIL=gamboa.khinandrei@gmail.com

# PostgreSQL Connection String (Vercel Postgres or Supabase)
POSTGRES_URL=postgres://user:password@host:5432/database
